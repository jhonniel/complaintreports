# Public (safe for the Vite frontend — never put secret keys here)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TOMTOM_API_KEY=
VITE_API_BASE_URL=/api

# Server only (never expose these in the frontend)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PORT=3001
# Comma-separated browser origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Same map key can be used server-side to place reports from their address.
# TOMTOM_API_KEY=
# VITE_CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET_KEY=

# Development-only admin login (ignored in production and on Vercel)
# DEV_ADMIN_EMAIL=
# DEV_ADMIN_PASSWORD=

# Ticket emails via Resend. Sent only when the reporter includes an email.
# RESEND_API_KEY=
# RESEND_FROM="Tingog Page <report@tingogkidapawan.com>"
# Optional public origin used in the email's track link.
# PUBLIC_SITE_URL=https://complaintreports.vercel.app

# Production (Vercel → Project Settings → Environment Variables)
# Set the same keys for Production, Preview, and Development as needed.
# VITE_API_BASE_URL=/api
# CLIENT_ORIGIN=https://your-app.vercel.app
# NODE_ENV is set to production by Vercel.
# Do not set VITE_SUPABASE_SERVICE_ROLE_KEY. The service role is server-only.
# Production refuses the local JSON store; SUPABASE_SERVICE_ROLE_KEY is required.
